<?xml version="1.0" encoding="utf-8"?>
<!--
  On a targetSdk-35 edge-to-edge device the window draws full-screen by
  default and the nav bar sits as a transparent overlay on top, which
  silently eats touches on anything laid out underneath it — "Full model
  results" was drawn right at the very bottom and every tap on it landed on
  the nav bar's window instead of ours. android:fitsSystemWindows="true" also
  fixes the overlap but zeroes this view's own padding as a side effect
  instead of adding to it, so the fix is a manual window-insets listener in
  MainActivity.onCreate that adds the bar insets on top of this 28dp base
  padding rather than replacing it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/injini_text"
        android:textSize="20sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tagline"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/wordmark"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- A separate, always-visible way into the full fleet screen — not
         folded into the dropdown, so managing machines is never a hidden
         side effect of picking one. Anchored beside the wordmark, its own
         row, rather than squeezed against the picker chip where it crowded
         both controls and read as an afterthought. -->
    <!-- Icon color is baked into ic_fleet_24 itself, not applied via tint.
         layerType="software" works around a real device bug: on this
         Samsung SM-M075F, a small vector drawn as an ImageView/compound-
         drawable src renders as fully blank under hardware acceleration —
         confirmed with aapt2 that the resource and its binding were both
         correct, so this is a GPU/driver compositing issue, not a resource
         one. Shape drawables used as android:background were unaffected. -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/machinesButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layerType="software"
        android:background="@drawable/bg_chip"
        app:srcCompat="@drawable/ic_fleet_24"
        android:padding="9dp"
        android:contentDescription="Machines"
        app:layout_constraintTop_toTopOf="@id/wordmark"
        app:layout_constraintBottom_toBottomOf="@id/tagline"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The machine dropdown: tap to reveal every known machine plus "+ Add
         new machine", styled and worded so it reads as a control (a visible
         chevron), not as inert label text. -->
    <TextView
        android:id="@+id/machinePicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Select or add a machine  ⌄"
        android:textColor="@color/injini_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- This machine's attributes and progress, right here on the home
         screen — the old version made you leave the screen just to see what
         you already knew about a machine, which read as confusing. -->
    <TextView
        android:id="@+id/machineInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/machinePicker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown only once a false negative flags this machine: the fingerprint
         built at enrolment may include a bad sample, since a Check against
         it once read healthy on something a mechanic found genuinely wrong. -->
    <TextView
        android:id="@+id/reenrollBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layerType="software"
        android:background="@drawable/bg_chip"
        android:drawableStart="@drawable/ic_warning_red_24"
        android:drawablePadding="10dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Needs re-enrollment — a mechanic found a fault this fingerprint missed."
        android:textColor="@color/injini_red"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/machineInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- A real button, not a line of text hoping to be noticed. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addVerdictButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layerType="software"
        android:background="@drawable/bg_button"
        android:drawableStart="@drawable/ic_warning_amber_24"
        android:drawablePadding="10dp"
        android:text="Add verdict"
        android:textColor="@color/injini_amber"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:paddingVertical="10dp"
        android:stateListAnimator="@null"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/reenrollBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="STARTING"
        android:textColor="@color/injini_amber"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/addVerdictButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/detailText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Loading the embedder."
        android:textColor="@color/injini_dim"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/statusWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/latencyChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="embed — ms"
        android:textColor="@color/injini_dim"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/detailText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hidden until a recording starts. A continuous idle ripple plus a
         breathing REC dot run the whole time, so it never looks stuck even
         in a silent room — see WaveformView.start(). -->
    <com.injini.app.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/latencyChip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Only visible while a recording is actually running (see waveform,
         above) — recording used to be uninterruptible once started. -->
    <TextView
        android:id="@+id/cancelRecordingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cancel"
        android:textColor="@color/injini_red"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/waveform"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      Plain AppCompatButton, not <Button> — the Material Components theme
      auto-promotes a bare <Button> to MaterialButton, which paints its own
      colorPrimary-filled background and ignores android:background entirely.
      That silently turned the Enrol button into a solid amber Material
      button instead of the flat dark-with-stroke style used everywhere else.
    -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/checkButton"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_button"
        android:text="@string/check"
        android:textColor="@color/injini_amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/enrolButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/enrolButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:text="@string/enrol"
        android:textColor="@color/injini_text"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/resultsLink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/resultsLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/full_results"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/howItWorksLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How this works"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
