<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/injini_text"
        android:textSize="20sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tagline"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/wordmark"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/statusWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="STARTING"
        android:textColor="@color/injini_amber"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp" />

    <TextView
        android:id="@+id/detailText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Loading the embedder."
        android:textColor="@color/injini_dim"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/statusWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/latencyChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="embed — ms"
        android:textColor="@color/injini_dim"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/detailText"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/checkButton"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_button"
        android:text="@string/check"
        android:textColor="@color/injini_amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/enrolButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/enrolButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:text="@string/enrol"
        android:textColor="@color/injini_text"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/resultsLink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/resultsLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/full_results"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
