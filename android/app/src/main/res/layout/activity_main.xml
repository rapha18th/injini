<?xml version="1.0" encoding="utf-8"?>
<!--
  On a targetSdk-35 edge-to-edge device the window draws full-screen by
  default and the nav bar sits as a transparent overlay on top, which
  silently eats touches on anything laid out underneath it — "Full model
  results" was drawn right at the very bottom and every tap on it landed on
  the nav bar's window instead of ours. android:fitsSystemWindows="true" also
  fixes the overlap but zeroes this view's own padding as a side effect
  instead of adding to it, so the fix is a manual window-insets listener in
  MainActivity.onCreate that adds the bar insets on top of this 28dp base
  padding rather than replacing it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/injini_text"
        android:textSize="20sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tagline"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/wordmark"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tap to switch machines or add a new one. Icon-free by design: a
         one-line text row reads as a control without extra chrome. -->
    <TextView
        android:id="@+id/machineRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Machine: none selected  ›"
        android:textColor="@color/injini_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="STARTING"
        android:textColor="@color/injini_amber"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/machineRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/detailText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Loading the embedder."
        android:textColor="@color/injini_dim"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/statusWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/latencyChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="embed — ms"
        android:textColor="@color/injini_dim"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/detailText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hidden until a recording starts; see MainActivity.showRecordingUi().
         A live level meter so a ten-second clip shows something moving on
         screen instead of a status line frozen for the whole duration. -->
    <com.injini.app.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/latencyChip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Plain AppCompatButton, not <Button> — the Material Components theme
      auto-promotes a bare <Button> to MaterialButton, which paints its own
      colorPrimary-filled background and ignores android:background entirely.
      That silently turned the Enrol button into a solid amber Material
      button instead of the flat dark-with-stroke style used everywhere else.
    -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/checkButton"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_button"
        android:text="@string/check"
        android:textColor="@color/injini_amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/enrolButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/enrolButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:text="@string/enrol"
        android:textColor="@color/injini_text"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/addClipButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addClipButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:text="@string/add_training_clip"
        android:textColor="@color/injini_green"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/resultsLink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/resultsLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/full_results"
        android:textColor="@color/injini_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
