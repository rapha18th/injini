<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/hfSyncRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync to Hugging Face"
                android:textColor="@color/injini_text"
                android:textSize="20sp"
                android:letterSpacing="0.05"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Push this phone's dataset through the Injini Relay into a private dataset repo — the same place the next Kaggle retrain reads from. This phone never holds a Hugging Face token, only a separate upload key the relay checks. Nothing here runs on its own; this is one deliberate tap, not a background sync."
                android:textColor="@color/injini_dim"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Relay URL"
                android:textColor="@color/injini_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The Injini Relay's address (hf_space/ in the repo, deployed as a Hugging Face Space) — ask whoever runs it for this."
                android:textColor="@color/injini_dim"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3" />

            <EditText
                android:id="@+id/hfUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:hint="https://username-injini-relay.hf.space"
                android:textColor="@color/injini_text"
                android:textColorHint="@color/injini_dim"
                android:textSize="14sp"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Upload key"
                android:textColor="@color/injini_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Not a Hugging Face token — a separate key set on the relay. If it ever leaks from this phone, the most it allows is opening a pull request, never writing to the dataset directly."
                android:textColor="@color/injini_dim"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3" />

            <EditText
                android:id="@+id/hfKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:hint="upload key"
                android:textColor="@color/injini_text"
                android:textColorHint="@color/injini_dim"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:maxLines="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hfSaveButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:layerType="software"
                android:background="@drawable/bg_button"
                android:text="Save"
                android:textColor="@color/injini_text"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hfUploadButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layerType="software"
                android:background="@drawable/bg_button"
                android:drawableStart="@drawable/ic_export_24"
                android:drawablePadding="10dp"
                android:text="Upload now"
                android:textColor="@color/injini_amber"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
