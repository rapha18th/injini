<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/hfSyncRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/hfTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync to Injini Cloud"
        android:textColor="@color/injini_text"
        android:textSize="20sp"
        android:letterSpacing="0.05"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Send this phone's recordings to Injini Cloud so they can help train the next update. This is one deliberate tap, not something that happens on its own."
        android:textColor="@color/injini_dim"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/hfTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/hfSubtitle" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/hfUploadButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:layerType="software"
        android:background="@drawable/bg_button"
        android:drawableStart="@drawable/ic_export_24"
        android:drawablePadding="10dp"
        android:text="Sync now"
        android:textColor="@color/injini_amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/hfSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
