<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/onboardingRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/injini_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/onboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="How Injini works"
        android:textColor="@color/injini_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/onboardingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Two things you do. Everything else follows from them."
        android:textColor="@color/injini_dim"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/onboardingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/onboardingScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/onboardingSubtitle"
        app:layout_constraintBottom_toTopOf="@id/onboardingDoneButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button"
                android:padding="16dp"
                android:text="1. Enrol\nRecords 6 ten-second clips while the machine runs normally. Builds that machine&#8217;s healthy fingerprint. Every clip joins the training corpus as healthy — by construction, no extra step."
                android:textColor="@color/injini_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button"
                android:padding="16dp"
                android:text="2. Check\nRecords 1 clip and compares it to that fingerprint. You get an instant read: sounds like itself, worth checking, or get it looked at. That is the model&#8217;s guess, not a verdict yet."
                android:textColor="@color/injini_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button"
                android:padding="16dp"
                android:text="3. Add verdict\nOnce a mechanic has actually looked, say what was really true — healthy confirmed, or the real fault. This is the step that turns a Check into training data, and Injini into a live benchmark of its own model."
                android:textColor="@color/injini_amber"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_warn"
                android:padding="16dp"
                android:text="Only enrol while it is genuinely healthy right now.\n\nEnrol builds the machine&#8217;s whole idea of &#8220;normal.&#8221; If a problem is already there when you enrol, that problem becomes the new normal. Not sure? Check it instead, and enrol later."
                android:textColor="@color/injini_red"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="WHAT HAPPENS ON ITS OWN"
                android:textColor="@color/injini_dim"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="• If a mechanic finds a fault that Check once read as healthy, that machine is flagged &#8220;needs re-enrollment.&#8221; The flag clears the next time it is enrolled.\n\n• Every Check&#8217;s on-device guess is compared against its eventual verdict. The fleet-wide tally is in &#8220;Full model results.&#8221;\n\n• Export and Sync to Injini Cloud send the whole collection, on request only. Nothing leaves the phone on its own."
                android:textColor="@color/injini_dim"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.35" />

            <TextView
                android:id="@+id/onboardingShareLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Know someone who should have this app? Send them the direct link:\ngithub.com/rapha18th/injini/releases/latest/download/app-debug.apk"
                android:textColor="@color/injini_amber"
                android:textSize="13sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/onboardingDoneButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button"
        android:text="Got it"
        android:textColor="@color/injini_amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
