# data (downloaded, not committed)
data/dcase2025_dev/
data/_calib_synth/
data/_*.log
data/*.csv
!data/.gitkeep

# EfficientAT weights (downloaded from GitHub releases)
vendor_efficientat/resources/*.pt
vendor_efficientat/resources/*.pth

# intermediate artefacts (regenerated by export scripts, not worth keeping)
models/*_preproc.onnx

# the shipped ONNX artifacts, eval results and quant reports ARE committed —
# they're the deliverable a Kaggle run produces, same precedent as SiloSense's
# models/*.onnx. Re-running the notebook overwrites them with a new snapshot.

# python
__pycache__/
*.pyc
.venv/

# android
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/*.onnx

*.DS_Store
